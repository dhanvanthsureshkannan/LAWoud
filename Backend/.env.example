# ---------------------------------------------------------------------------
# LAWoud backend configuration
# Copy this file to `.env` and fill in your keys.  Never commit `.env`.
# ---------------------------------------------------------------------------

# --- AI providers -----------------------------------------------------------
# Primary. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Automatic fallback when Gemini errors / times out / hits quota.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Seconds before a provider call is abandoned and the fallback takes over.
AI_TIMEOUT_SECONDS=30

# --- Web search (fallback only, when local knowledge is insufficient) --------
# Get one at https://app.tavily.com
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=6

# --- Local knowledge base ---------------------------------------------------
# Two files are loaded together as one searchable corpus:
#  - CONSTITUTION_FILE: the Constitution, parsed per-Article (no headings needed
#    in the file itself -- a dedicated parser finds "Article N -- Title" lines).
#  - KNOWLEDGE_FILE: a heading-structured guide for everything the Constitution
#    doesn't cover (FIR filing, tenancy, cheque bounce, etc).
# Both hot-reload independently on change.
CONSTITUTION_FILE=General provisions all.md
KNOWLEDGE_FILE=data/legal_knowledge.md

# Repealed/omitted Articles (Status: Omitted / Historical in the source file)
# are parsed but excluded from retrieval unless this is turned on -- citing a
# repealed Article as live law is the failure mode this guards against.
INCLUDE_OMITTED_ARTICLES=false

# Curated local advocate directory -- fallback tier when the live judicial-
# record search (Tavily) finds nothing. Optional: if the file is missing, that
# tier is simply empty and the flow falls through to national legal-aid
# contacts, same as if this were never set.
LAWYER_DIRECTORY_FILE=LAWOUD_Lawyer_Directory final.md

# Sufficiency gate: local knowledge is used only when ALL THREE pass.
# Lower these to prefer local knowledge; raise them to trigger web search sooner.
# Set higher than a single-file default because the Constitution alone adds
# ~470 sections to the corpus -- a low bar would pass on almost any query and
# web search would rarely run.
KNOWLEDGE_MIN_SCORE=8.0         # best single-section relevance score
KNOWLEDGE_MIN_COVERAGE=0.5      # fraction of query keywords the section covers
KNOWLEDGE_MIN_CONTEXT_CHARS=400
KNOWLEDGE_TOP_K=4              # sections passed to the model as context
KNOWLEDGE_MAX_SECTION_CHARS=4000

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated frontend origins. "*" is fine for a localhost hackathon demo.
CORS_ORIGINS=*
LOG_LEVEL=INFO
